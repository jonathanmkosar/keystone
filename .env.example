# Non-secret configuration. Copy to .env for local overrides.
# Secrets (OpenAI key, SimpleFIN token, Yahoo OAuth) live in OS keychain.

# Root directory holding per-stone USER DATA (data.db, memory.db, docs/).
# Anything under this folder is gitignored by default.
KEYSTONE_STONES_DIR=./stones

# Root directory holding stone PACKAGES (handlers.py, schema.sql, config.json).
# Stone packages are added to sys.path so handlers can be referenced as
# '<stone_name>.handlers.X' from each stone's config.json.
KEYSTONE_STONES_PKG_DIR=./stones_pkg

# Default HTTP bind for the remote transport (Cloudflare Tunnel terminates TLS).
KEYSTONE_HTTP_HOST=127.0.0.1
KEYSTONE_HTTP_PORT=8787

# Public base domain. Each stone is reachable at <stone>.<base-domain>.
KEYSTONE_BASE_DOMAIN=your-domain.com

# Cloudflare Access (remote auth). Required when running HTTP transport publicly.
# CF_ACCESS_TEAM is your team slug (e.g. yourcompany -> yourcompany.cloudflareaccess.com).
# CF_ACCESS_AUD_<NAME> is the per-application Audience tag from the Access dashboard.
# CF_ACCESS_TEAM=your-team
# CF_ACCESS_AUD_YAHOO_FANTASY_BASEBALL_STONE=replace-with-app-aud-tag
# CF_ACCESS_AUD_PERSONAL_ACCOUNTANT_STONE=replace-with-app-aud-tag

# OpenAI embedding model (used for semantic_search + save_memory).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Logging
KEYSTONE_LOG_LEVEL=INFO
