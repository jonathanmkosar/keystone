{
  "components": {
    "schemas": {
      "Error": {
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code",
          "request_id"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "keystone_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Every client of Keystone uses this API. A call carries its session in the keystone_session cookie, and the session alone says whose data the call reaches. A route marked x-keystone-door is served before sign-in. Every answer carries an X-Request-Id header.",
    "title": "Keystone",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/audit": {
      "get": {
        "parameters": [
          {
            "description": "Return the entries written after the entry with this id.",
            "in": "query",
            "name": "after",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The most entries to return. Never more than the server.page_limit setting.",
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Keep one kind of call: api, model or tool.",
            "in": "query",
            "name": "kind",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Keep the entries of one API call.",
            "in": "query",
            "name": "request_id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "entries": {
                      "items": {
                        "properties": {
                          "action": {
                            "type": "string"
                          },
                          "actor": {
                            "type": "string"
                          },
                          "at": {
                            "format": "date-time",
                            "type": "string"
                          },
                          "cost_micros": {
                            "type": "integer"
                          },
                          "duration_ms": {
                            "type": "integer"
                          },
                          "id": {
                            "type": "integer"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "outcome": {
                            "type": "string"
                          },
                          "received": {
                            "type": "string"
                          },
                          "request_id": {
                            "type": "string"
                          },
                          "sent": {
                            "type": "string"
                          },
                          "status": {
                            "type": "integer"
                          },
                          "usage": {
                            "properties": {
                              "cache_read_tokens": {
                                "type": "integer"
                              },
                              "cache_write_tokens": {
                                "type": "integer"
                              },
                              "estimated": {
                                "type": "boolean"
                              },
                              "input_tokens": {
                                "type": "integer"
                              },
                              "output_tokens": {
                                "type": "integer"
                              },
                              "thinking_tokens": {
                                "type": "integer"
                              }
                            },
                            "required": [
                              "input_tokens",
                              "output_tokens"
                            ],
                            "type": "object"
                          }
                        },
                        "required": [
                          "id",
                          "at",
                          "kind",
                          "request_id",
                          "actor",
                          "action",
                          "outcome",
                          "usage",
                          "cost_micros",
                          "duration_ms"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "next_after": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "entries",
                    "next_after"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The call did what was asked."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The call was refused or failed."
          }
        },
        "summary": "The signed-in person's audit log, oldest first, a page at a time."
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "The call did what was asked."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The call was refused or failed."
          }
        },
        "summary": "This document."
      }
    },
    "/api/v1/session": {
      "delete": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "signed_out": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "signed_out"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The call did what was asked."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The call was refused or failed."
          }
        },
        "summary": "Sign out: end this session and forget its cookie."
      },
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "person": {
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name"
                      ],
                      "type": "object"
                    },
                    "session": {
                      "properties": {
                        "created": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "expires": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        },
                        "method": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "method",
                        "created",
                        "expires"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "person",
                    "session"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The call did what was asked."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The call was refused or failed."
          }
        },
        "summary": "Who is signed in, and until when."
      },
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "password": {
                    "type": "string"
                  },
                  "tenant": {
                    "type": "string"
                  }
                },
                "required": [
                  "tenant",
                  "password"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "person": {
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name"
                      ],
                      "type": "object"
                    },
                    "session": {
                      "properties": {
                        "created": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "expires": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        },
                        "method": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "method",
                        "created",
                        "expires"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "person",
                    "session"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The call did what was asked."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The call was refused or failed."
          }
        },
        "security": [],
        "summary": "Sign in with a password. The session token comes back in a cookie the page's scripts cannot read, and never in the body.",
        "x-keystone-door": true
      }
    },
    "/api/v1/signin/people": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "listed": {
                      "type": "boolean"
                    },
                    "people": {
                      "items": {
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "listed",
                    "people"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "The call did what was asked."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The call was refused or failed."
          }
        },
        "security": [],
        "summary": "The people who can sign in to this install, for the sign-in screen. Empty when the signin.list_people setting is off.",
        "x-keystone-door": true
      }
    },
    "/api/v1/stream/test": {
      "get": {
        "parameters": [
          {
            "description": "How many tick events to send, 1 to 100. Three unless given.",
            "in": "query",
            "name": "count",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-keystone-events": [
                  {
                    "data": {
                      "properties": {
                        "n": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "n"
                      ],
                      "type": "object"
                    },
                    "description": "One count. Its id is the count.",
                    "event": "tick"
                  },
                  {
                    "data": {
                      "properties": {
                        "n": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "n"
                      ],
                      "type": "object"
                    },
                    "description": "The last event. It has no id.",
                    "event": "done"
                  }
                ]
              }
            },
            "description": "The call did what was asked."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The call was refused or failed."
          }
        },
        "summary": "A stream that counts, for building and checking a client's event reader. It honours Last-Event-ID."
      }
    }
  },
  "security": [
    {
      "session": []
    }
  ]
}
