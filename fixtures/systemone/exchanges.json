    {
      "name": "yes-no-with-key",
      "about": "A yes or no, described, answered as Ollama's noul: the probability of true. A gateway on the home network that asks for a key. The endpoint is written with /v1 on it, which is not doubled.",
      "entry": {
        "name": "gateway-decide",
        "label": "Gateway decisions",
        "adapter": "systemone",
        "endpoint": "http://127.0.0.1:11434/v1",
        "provider_model": "example-decide:27b",
