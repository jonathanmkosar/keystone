        "class": "local"
      },
      "uses_key": true,
      "request": {
        "model": "gateway-decide",
        "state": "Please read the attached plan for the shed and tell me what is missing.",
        "questions": [
          {
            "id": "needs_file",
            "instructions": "Does the message ask about a file?",
            "type": "yes_no",
            "options": [{"id": "yes", "description": "It names or attaches a file"}, {"id": "no", "description": "It does not"}]
          },
          {
            "id": "urgent",
            "instructions": "Is the message urgent?",
            "type": "yes_no"
          }
        ]
      },
      "sent": {
        "model": "example-decide:27b",
        "state": "Please read the attached plan for the shed and tell me what is missing.",
        "questions": {
          "needs_file": {
            "type": "noul",
            "instructions": "Does the message ask about a file?",
            "criteria": {"true": "It names or attaches a file", "false": "It does not"}
          },
          "urgent": {"type": "noul", "instructions": "Is the message urgent?"}
        }
      },
      "sent_order": ["needs_file", "urgent"],
      "answer": {
        "model": "example-decide:27b",
        "answers": {
          "needs_file": {"type": "noul", "noul": 0.875},
          "urgent": {"type": "noul", "noul": 0.25}
