{
  "about": "Invented exchanges for effort on the seam (P14-01): the request, the setting, and the body the adapter must send. Every one is answered by the same short stream in the test.",
  "exchanges": [
    {
      "name": "effort-low",
      "about": "With the setting on, effort low is sent as reasoning_effort, as it is asked.",
      "capabilities": [
        "tools",
        "thinking"
      ],
      "send_reasoning_effort": true,
      "request": {
        "effort": "low",
        "messages": [
          {
            "blocks": [
              {
                "text": "Plan three dinners for the week.",
                "type": "text"
              }
            ],
            "role": "user"
          }
        ],
        "model": "house-small"
      },
      "sent": {
        "messages": [
          {
            "content": "Plan three dinners for the week.",
            "role": "user"
          }
        ],
        "model": "example-small:8b",
        "reasoning_effort": "low",
        "stream": true,
        "stream_options": {
          "include_usage": true
        }
      }
    },
