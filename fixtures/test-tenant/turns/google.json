            "message": {
              "role": "assistant",
              "blocks": [
                {
                  "type": "tool_call",
                  "id": "call_swim",
                  "name": "calendar_create_event",
                  "input": { "title": "Swim", "start": "2026-11-26T07:00", "end": "2026-11-26T08:00", "time_zone": "America/Chicago" }
                }
              ]
            },
            "stop_reason": "tool_call",
            "usage": { "input_tokens": 480, "output_tokens": 40 }
          }
        },
        {
          "reply": {
            "message": {
              "role": "assistant",
