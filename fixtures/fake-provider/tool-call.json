            "stop_reason": "end",
            "usage": { "input_tokens": 310, "output_tokens": 19 }
          }
        }
      ]
    },
    {
      "name": "two tools at once",
      "when": { "user_text": "What time is it, and when is the next north ferry?" },
      "steps": [
        {
          "reply": {
            "message": {
              "role": "assistant",
              "blocks": [
                { "type": "tool_call", "id": "call_1", "name": "current_time", "input": {} },
                {
                  "type": "tool_call",
                  "id": "call_2",
                  "name": "lookup_timetable",
                  "input": { "route": "north", "day": "today" }
                }
              ]
            },
            "stop_reason": "tool_call",
            "usage": { "input_tokens": 252, "output_tokens": 41 }
          }
