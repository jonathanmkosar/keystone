{
  "test_data": true,
  "about": "Invented exchanges with an invented endpoint, written by hand from the public description of the Responses API. Nothing here was captured from a provider.",
  "cases": [
    {
      "name": "reasoning-then-answer",
      "note": "A thinking budget of 8000 asks for medium effort and a summary. The summary's two parts become one thinking block, and the encrypted reasoning becomes its signature.",
      "capabilities": ["thinking"],
      "request": {
        "messages": [
          {"role": "user", "blocks": [{"type": "text", "text": "When is the next North Ferry after half past nine?"}]}
        ],
        "thinking_tokens": 8000
      },
      "exchanges": [
        {
          "wire_request": {
            "model": "example-model-1",
            "input": [
              {"role": "user", "content": [{"type": "input_text", "text": "When is the next North Ferry after half past nine?"}]}
            ],
            "reasoning": {"effort": "medium", "summary": "auto"},
            "include": ["reasoning.encrypted_content"],
            "store": false,
            "stream": true
          },
          "events": [
            {"type": "response.created", "response": {"id": "resp_invented_020", "status": "in_progress"}},
            {"type": "response.output_item.added", "output_index": 0, "item": {"id": "rs_invented_002", "type": "reasoning", "summary": []}},
            {"type": "response.reasoning_summary_part.added", "item_id": "rs_invented_002", "output_index": 0, "summary_index": 0, "part": {"type": "summary_text", "text": ""}},
            {"type": "response.reasoning_summary_text.delta", "item_id": "rs_invented_002", "output_index": 0, "summary_index": 0, "delta": "The ferry "},
            {"type": "response.reasoning_summary_text.delta", "item_id": "rs_invented_002", "output_index": 0, "summary_index": 0, "delta": "runs on the hour."},
            {"type": "response.reasoning_summary_text.done", "item_id": "rs_invented_002", "output_index": 0, "summary_index": 0, "text": "The ferry runs on the hour."},
            {"type": "response.reasoning_summary_part.done", "item_id": "rs_invented_002", "output_index": 0, "summary_index": 0, "part": {"type": "summary_text", "text": "The ferry runs on the hour."}},
            {"type": "response.reasoning_summary_part.added", "item_id": "rs_invented_002", "output_index": 0, "summary_index": 1, "part": {"type": "summary_text", "text": ""}},
            {"type": "response.reasoning_summary_text.delta", "item_id": "rs_invented_002", "output_index": 0, "summary_index": 1, "delta": "So the next one is at ten."},
            {"type": "response.reasoning_summary_part.done", "item_id": "rs_invented_002", "output_index": 0, "summary_index": 1, "part": {"type": "summary_text", "text": "So the next one is at ten."}},
            {"type": "response.output_item.done", "output_index": 0, "item": {"id": "rs_invented_002", "type": "reasoning", "summary": [{"type": "summary_text", "text": "The ferry runs on the hour."}, {"type": "summary_text", "text": "So the next one is at ten."}], "encrypted_content": "aW52ZW50ZWQtcmVhc29uaW5nLXR3bw=="}},
            {"type": "response.output_item.added", "output_index": 1, "item": {"id": "msg_invented_020", "type": "message", "role": "assistant", "status": "in_progress", "content": []}},
            {"type": "response.output_text.delta", "item_id": "msg_invented_020", "output_index": 1, "content_index": 0, "delta": "The next ferry is at ten."},
            {"type": "response.output_item.done", "output_index": 1, "item": {"id": "msg_invented_020", "type": "message", "role": "assistant", "status": "completed", "content": [{"type": "output_text", "text": "The next ferry is at ten.", "annotations": []}]}},
            {"type": "response.completed", "response": {"id": "resp_invented_020", "status": "completed", "usage": {"input_tokens": 20, "input_tokens_details": {"cached_tokens": 0}, "output_tokens": 60, "output_tokens_details": {"reasoning_tokens": 40}, "total_tokens": 80}}}
          ]
        }
      ],
      "response": {
        "model": "example-responses",
        "message": {
          "role": "assistant",
          "blocks": [
            {"type": "thinking", "text": "The ferry runs on the hour.\n\nSo the next one is at ten.", "signature": "responses/1:{\"id\":\"rs_invented_002\",\"encrypted_content\":\"aW52ZW50ZWQtcmVhc29uaW5nLXR3bw==\"}"},
            {"type": "text", "text": "The next ferry is at ten."}
          ]
        },
        "stop_reason": "end",
        "usage": {"input_tokens": 20, "output_tokens": 60, "thinking_tokens": 40}
      }
    },
    {
      "name": "reasoning-withheld",
      "note": "A large budget asks for high effort. The provider sends no summary, only the encrypted reasoning, which arrives whole. The thinking block has a signature and no text.",
      "capabilities": ["thinking"],
      "request": {
        "messages": [
          {"role": "user", "blocks": [{"type": "text", "text": "Plan the walk to the lighthouse."}]}
        ],
        "thinking_tokens": 20000
      },
      "exchanges": [
        {
          "wire_request": {
            "model": "example-model-1",
            "input": [
              {"role": "user", "content": [{"type": "input_text", "text": "Plan the walk to the lighthouse."}]}
            ],
            "reasoning": {"effort": "high", "summary": "auto"},
            "include": ["reasoning.encrypted_content"],
            "store": false,
            "stream": true
          },
          "events": [
            {"type": "response.output_item.done", "output_index": 0, "item": {"id": "rs_invented_003", "type": "reasoning", "summary": [], "encrypted_content": "aW52ZW50ZWQtd2l0aGhlbGQ="}},
            {"type": "response.output_text.delta", "item_id": "msg_invented_021", "output_index": 1, "content_index": 0, "delta": "Leave at nine and follow the cliff path."},
            {"type": "response.completed", "response": {"id": "resp_invented_021", "status": "completed", "usage": {"input_tokens": 12, "input_tokens_details": {"cached_tokens": 0}, "output_tokens": 300, "output_tokens_details": {"reasoning_tokens": 290}, "total_tokens": 312}}}
          ]
        }
      ],
      "response": {
        "model": "example-responses",
        "message": {
          "role": "assistant",
          "blocks": [
            {"type": "thinking", "signature": "responses/1:{\"id\":\"rs_invented_003\",\"encrypted_content\":\"aW52ZW50ZWQtd2l0aGhlbGQ=\"}"},
            {"type": "text", "text": "Leave at nine and follow the cliff path."}
          ]
        },
        "stop_reason": "end",
        "usage": {"input_tokens": 12, "output_tokens": 300, "thinking_tokens": 290}
      }
    }
  ]
}
